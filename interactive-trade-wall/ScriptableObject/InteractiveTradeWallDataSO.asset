          title: Carnelian
          title_marathi: 
          description: A red-orange chalcedony widely traded in antiquity.
          description_marathi: "\u092E\u0930\u093E\u0920\u0940 \u092D\u093E\u0937\u0947\u091A\u093E
            \u0935\u093F\u0915\u093E\u0938 \u0939\u093E \u0938\u093E\u092E\u093E\u091C\u093F\u0915,
            \u0938\u093E\u0902\u0938\u094D\u0915\u0943\u0924\u093F\u0915 \u0906\u0923\u093F
            \u0927\u093E\u0930\u094D\u092E\u093F\u0915 \u0918\u091F\u0915\u093E\u0902\u0936\u0940
            \u0918\u091F\u094D\u091F\u092A\u0923\u0947 \u0928\u093F\u0917\u0921\u093F\u0924
            \u0906\u0939\u0947. \u092E\u0927\u094D\u092F\u092F\u0941\u0917\u0940\u0928
            \u0915\u093E\u0933\u093E\u0924 \u0938\u0902\u0924 \u091C\u094D\u091E\u093E\u0928\u0947\u0936\u094D\u0935\u0930,
            \u0928\u093E\u092E\u0926\u0947\u0935, \u0924\u0941\u0915\u093E\u0930\u093E\u092E
            \u0906\u0923\u093F \u090F\u0915\u0928\u093E\u0925 \u092F\u093E\u0902\u091A\u094D\u092F\u093E
            \u0905\u092D\u0902\u0917\u0930\u091A\u0928\u093E\u0902\u092E\u0941\u0933\u0947
            \u092D\u093E\u0937\u0947\u0932\u093E \u090F\u0915 \u0905\u0926\u094D\u0935\u093F\u0924\u0940\u092F
            \u0932\u094B\u0915\u093E\u092D\u093F\u092E\u0941\u0916 \u0938\u094D\u0935\u0930\u0942\u092A
            \u092A\u094D\u0930\u093E\u092A\u094D\u0924 \u091D\u093E\u0932\u0947.
            \u0926\u0947\u0935\u0917\u093F\u0930\u0940, \u092A\u0948\u0920\u0923,
            \u0906\u0923\u093F \u092A\u0902\u0922\u0930\u092A\u0942\u0930 \u092F\u093E
            \u0915\u0947\u0902\u0926\u094D\u0930\u093E\u0902\u092E\u0927\u0942\u0928
            \u092A\u094D\u0930\u0938\u093E\u0930\u093F\u0924 \u091D\u093E\u0932\u0947\u0932\u094D\u092F\u093E
            \u092D\u0915\u094D\u0924\u093F\u092A\u0930\u0902\u092A\u0930\u0947\u0924
            \u0935\u093F\u0920\u094D\u0920\u0932\u092D\u0915\u094D\u0924\u0940\u091A\u093E
            \u092A\u094D\u0930\u092D\u093E\u0935 \u0935\u093F\u0936\u0947\u0937\u0924\u094D\u0935\u093E\u0928\u0947
            \u0926\u093F\u0938\u0942\u0928 \u092F\u0947\u0924\u094B. \u092A\u094D\u0930\u093E\u091A\u0940\u0928
            \u0939\u0938\u094D\u0924\u0932\u093F\u0916\u093F\u0924\u093E\u0902\u092E\u0927\u094D\u092F\u0947
            \u0906\u0922\u0933\u0923\u093E\u0931\u094D\u092F\u093E \u0932\u093F\u092A\u0940\u0902\u091A\u094D\u092F\u093E
            \u0935\u093F\u0935\u093F\u0927\u0924\u0947\u092E\u0941\u0933\u0947 \u092D\u093E\u0937\u093E\u0936\u093E\u0938\u094D\u0924\u094D\u0930\u0940\u092F
            \u0905\u092D\u094D\u092F\u093E\u0938\u093E\u0932\u093E \u0905\u0927\u093F\u0915
            \u0938\u0916\u094B\u0932 \u092A\u0930\u093F\u092E\u093E\u0923 \u0932\u093E\u092D\u0924\u0947.
            \u0936\u093F\u0932\u093E\u0932\u0947\u0916, \u0924\u093E\u092E\u094D\u0930\u092A\u0924\u094D\u0930\u0947
            \u0906\u0923\u093F \u0917\u094D\u0930\u0902\u0925\u0938\u0902\u092A\u0926\u093E
            \u092F\u093E\u0902\u092E\u0927\u0940\u0932 \u092D\u093E\u0937\u093F\u0915
            \u0932\u0915\u094D\u0937\u0923\u093E\u0902\u091A\u093E \u0924\u0941\u0932\u0928\u093E\u0924\u094D\u092E\u0915
            \u0905\u092D\u094D\u092F\u093E\u0938 \u0915\u0947\u0932\u094D\u092F\u093E\u0938
            \u092E\u0930\u093E\u0920\u0940\u091A\u094D\u092F\u093E \u0927\u094D\u0935\u0928\u093F\u0936\u093E\u0938\u094D\u0924\u094D\u0930\u0940\u092F
            \u0906\u0923\u093F \u0935\u094D\u092F\u093E\u0915\u0930\u0923\u093F\u0915
            \u0930\u091A\u0928\u0947\u0924\u0940\u0932 \u0938\u093E\u0924\u0924\u094D\u092F
            \u0938\u094D\u092A\u0937\u094D\u091F\u092A\u0923\u0947 \u091C\u093E\u0923\u0935\u0924\u0947."
